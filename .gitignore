
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
.beads.gate.lock

# Worktrees live in the repository (D-5, lifted 2026-09-23 — bead coding-harness-m34):
# Claude Code puts them here, and the main checkout must not list them as untracked.
.claude/worktrees/

# Das gerenderte Bild des Trackers reist nicht mehr im Git (bead 1jg.3, D-52):
# die CI rendert einmal pro Lauf an genau diesen Pfad und setzt BEAD_RENDER.
# Hier ignoreiert, damit kein `git add -A` die Kopie ins Repo zurueckholt.
.beads/issues.jsonl

# macOS finder noise
.DS_Store

# Runtime policies of `stage2.py session` (bead coding-harness-amp): fresh
# private directories a failed attempt cleans and an accepted one keeps for
# the session to load. They hold no prompt and no credential, and they are
# the machine's business, never tracked.
.stage2-sessions/

# Python
__pycache__/
*.pyc
.venv/
implementation_plan.md

# The lychee action writes its report into the workspace (lychee/out.md).
# It is CI output, never a tracked file — without this line the kit probe
# reports it as an unclassified file and `--strict` turns the run red.
lychee/

# The runner's pinned Pi install (bead coding-harness-agx): the dependency
# graph is rebuildable with `bash tools/pi/install.sh` and never tracked; the
# manifest and its lock file are.
tools/pi/node_modules/
