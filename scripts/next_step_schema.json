{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "next-step instruction, version 1",
  "description": "The instruction a runner verb leaves beside the loop record (`next.json`) for the caller that reads machine state. A `hand` instruction names its rows; every other verb carries an empty row list.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "change", "verb", "row_ids", "producer", "written_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "change": {"type": "string", "minLength": 1},
    "verb": {"type": "string", "enum": ["review", "repair", "hand", "review-loop"]},
    "row_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "producer": {"type": "string", "minLength": 1},
    "written_at": {
      "type": "string",
      "pattern": "^(?:(?!0000)[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"verb": {"const": "hand"}}, "required": ["verb"]},
      "then": {"properties": {"row_ids": {"minItems": 1}}},
      "else": {"properties": {"row_ids": {"maxItems": 0}}}
    }
  ]
}
