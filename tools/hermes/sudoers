# /etc/sudoers.d/coding-harness-hermes - the one command the maintainer may run as the service user.
# @MAINTAINER@ stands for the maintainer's account name; the runbook (README, "Install") substitutes
# it, checks the result with `visudo -cf` and installs it root-owned, mode 440. One rule, one command,
# one target user, no password: the installed wrapper and nothing else.
# The wrapper reads the agent's two API keys on its standard input (decisions, addendum of 2026-10-06).
# sudo's I/O logging would write that input to disk (`man sudoers`: log_input, log_stdin), so both are
# pinned off for the wrapper; command-specific Defaults are applied after the general ones (findings F-33).
Defaults!/usr/local/libexec/coding-harness/recheck-agent !log_input, !log_stdin
@MAINTAINER@ ALL=(_chhermes) NOPASSWD: /usr/local/libexec/coding-harness/recheck-agent
