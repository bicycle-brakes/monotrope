# Template for $HERMES_HOME/.env of the service user _chhermes. Names only: the values are filled in
# at the laptop and never leave it. The file is installed owned by the maintainer, mode 640, so the
# service user can read it and cannot change it. No other model key belongs in it, and no credential
# of any code host: the agent holds neither.

# This agent's own OpenCode Go key (not adhd-relief's), from the vendor's console.
OPENCODE_GO_API_KEY=
# The shared egress proxy's route to OpenCode Go: http://127.0.0.1:8787/go/v1
OPENCODE_GO_BASE_URL=

# This agent's own Firecrawl key, for web_search and web_extract.
FIRECRAWL_API_KEY=
# The shared egress proxy's route to Firecrawl: http://127.0.0.1:8787/fc
FIRECRAWL_API_URL=
