{
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 15
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "~/.claude/hooks/handover.sh start", "timeout": 15 } ] },
      { "hooks": [ { "type": "command", "command": "~/.claude/hooks/parallel-sessions.sh start", "timeout": 10 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "~/.claude/hooks/recap.sh prompt", "async": true } ] },
      { "hooks": [ { "type": "command", "command": "~/.claude/hooks/parallel-sessions.sh prompt", "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "~/.claude/hooks/recap.sh stop", "async": true } ] }
    ]
  }
}
