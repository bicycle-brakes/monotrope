#!/usr/bin/env bash
# The pinned entry point to bd. Use this, not the bare `bd` on your PATH.
#
# WHY A WRAPPER EXISTS AT ALL
# The tracker database is shared through a Dolt remote (refs/dolt/data on
# origin). That makes bd a piece of shared infrastructure rather than a local
# tool: a version mismatch no longer breaks one machine, it refuses writes for
# everyone at once.
#
# WHAT IT DOES
#   1. refuses to run if your bd is not the pinned version (tools/beads/VERSION)
#   2. refuses `init`, `migrate` and `upgrade` — the three verbs that can
#      change the shared database's schema or its identity. The issue prefix
#      (`coding-harness-`) was fixed at init and is not correctable afterwards.
#
# THE ESCAPE HATCH
#   BD_PIN_BYPASS=1 lets a blocked verb through. It exists because a future
#   schema upgrade has to run `bd migrate` once, on one machine. If you are
#   reaching for it and you are not doing exactly that, stop and ask.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PINNED="$(tr -d '[:space:]' < "$REPO_ROOT/tools/beads/VERSION")"

die() { printf '%s\n' "$@" >&2; exit 1; }

# Side by side: other repositories on the same machine may still need an older
# global bd, and a newer bd migrates a store's schema on open — a one-way step.
# So the pinned binary is looked up as a versioned file first
# (~/.local/bin/bd-<pinned version>); only if that is missing does the bd on
# PATH get its chance, and the version check below decides. A bd inside this
# repository (the hook shim in tools/beads/bin) is never taken, to avoid a loop.
BD_BIN="${HOME}/.local/bin/bd-${PINNED}"
if [ ! -x "$BD_BIN" ]; then
  BD_BIN="$(command -v bd 2>/dev/null || true)"
  case "$BD_BIN" in "$REPO_ROOT"/*) BD_BIN="" ;; esac
fi
# Exit 127 — the shell's "command not found" — and only here: a caller such as
# scripts/render_beads_export.py tells "the tracker does not live on this
# machine" apart from every other failure by this code, not by the message.
if [ -z "$BD_BIN" ] || [ ! -x "$BD_BIN" ]; then
  printf '%s\n' "no bd binary found." \
    "Install bd $PINNED as ~/.local/bin/bd-${PINNED} (or as the bd on your PATH)." >&2
  exit 127
fi

# `bd version` prints e.g. "bd version 1.1.2 (20e493e56)"
INSTALLED="$("$BD_BIN" version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)"
if [ "$INSTALLED" != "$PINNED" ]; then
  die "bd version mismatch: you have ${INSTALLED:-unknown}, this repository is pinned to $PINNED." \
      "" \
      "A mismatched bd against the shared remote can refuse writes for the whole team, so this" \
      "is not a warning. Install version $PINNED and retry."
fi

for verb in init migrate upgrade; do
  if [ "${1:-}" = "$verb" ] && [ "${BD_PIN_BYPASS:-0}" != "1" ]; then
    die "'bd $verb' is blocked by tools/bd." \
        "The tracker prefix and schema are shared infrastructure; the prefix was fixed at init." \
        "If this is a deliberate one-time migration, run: BD_PIN_BYPASS=1 tools/bd $verb ..."
  fi
done

exec "$BD_BIN" "$@"
