{
  "coding-harness-start": {
    "SessionStart": [
      {
        "command": "./hooks/session-start.sh",
        "timeout": 30,
        "type": "command"
      }
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "cd .. && ${HARNESS_PYTHON:-$( [ -x .venv/bin/python ] && printf .venv/bin/python || printf python3 )} scripts/agent_policy_hooks.py antigravity",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "run_command|.*merge_pull_request"
      }
    ]
  }
}
